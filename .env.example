DATABASE_URL="file:./dev.db"

# Planner backend: "gemini" | "anthropic" | "manual"
LLM_PROVIDER=gemini

# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic, only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Jamendo, music by narrative arc: https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=

# Vision providers for clip tagging
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Whisper. Both empty means auto-detect: a runnable "whisper" executable on
# PATH, ~/Library/Python/*/bin, /opt/homebrew/bin or /usr/local/bin, else a
# python3 that can import the whisper module.
# WHISPER_PYTHON overrides with an interpreter, run as "python3 -m whisper".
# WHISPER_BIN overrides with an absolute path to the whisper executable.
WHISPER_PYTHON=
WHISPER_BIN=

# Root folder offered first by the disk folder importer. Defaults to $HOME.
CHAPTER_SOURCE_ROOT=
