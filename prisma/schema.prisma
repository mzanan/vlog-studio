generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id             String   @id @default(cuid())
  name           String
  intent         String?
  targetDuration Int?
  edl            Json?
  edlSuggestion  Json?
  musicBlocks    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  clips          Clip[]
}

model Clip {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename      String
  path          String
  durationMs    Int
  width         Int
  height        Int
  fps           Float
  hasVoice      Boolean   @default(false)
  wordsPerSec   Float?
  thumbnailPath String?
  transcribedAt DateTime?
  transcribeError String?
  createdAt     DateTime  @default(now())
  segments      Segment[]

  @@index([projectId])
}

model Segment {
  id        String @id @default(cuid())
  clipId    String
  clip      Clip   @relation(fields: [clipId], references: [id], onDelete: Cascade)
  startMs   Int
  endMs     Int
  text      String
  wordIndex Int

  @@index([clipId])
}
